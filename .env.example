# LLM 제공자 선택: "anthropic", "ollama", "hybrid"
LLM_PROVIDER=hybrid

# Anthropic API 키 (필요시 사용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# API에서 사용하는 Claude 고정 모델 ID
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# hybrid 모드에서 Claude를 우선 사용할 역할(기본은 Tool Reasoner만)
HYBRID_CLAUDE_ROLES=reasoning

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434
# 한국어 성능 좋은 모델 추천: llama3:8b, gemma2:9b, ggml-ko-gemma
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

# 기본 설정
MODEL_NAME=qwen2.5-coder:7b-instruct
MAX_TOKENS=4096
TEMPERATURE=0.7

# 데이터베이스 설정
DB_PATH=data/assistant.db

# RAG 모델은 실행 중 자동 다운로드하지 않고 아래 로컬 경로에서만 불러옵니다.
RAG_EMBEDDING_MODEL_PATH=data/models/bge-m3
# 선택 사항: 로컬 reranker 경로. 비우면 키워드 기반 재정렬을 사용합니다.
RAG_RERANKER_MODEL_PATH=
# auto는 CUDA가 있으면 GPU, 없으면 CPU를 사용합니다. 이 PC는 cuda 권장.
RAG_DEVICE=auto
WHISPER_DEVICE=auto
# 기본 STT는 CTranslate2 기반 faster-whisper를 사용합니다.
STT_ENGINE=faster-whisper
# 한국어 정확도 우선 모델. RTX 4060에서는 int8_float16으로 메모리를 절약합니다.
WHISPER_MODEL=large-v3
WHISPER_FALLBACK_MODEL=medium
WHISPER_CACHE_DIR=
WHISPER_COMPUTE_TYPE=int8_float16
# 음성 명령은 반드시 이 호출어로 시작해야 합니다.
WAKE_WORD=자비스
# Whisper가 고유명사와 명령 문맥을 더 안정적으로 해석하도록 주는 힌트입니다.
WHISPER_INITIAL_PROMPT=자비스를 호출한 사용자의 자연스러운 한국어 컴퓨터 제어 및 일상 대화 명령입니다.
# auto, PortAudio 장치 번호 또는 장치 이름 일부
MICROPHONE_DEVICE=auto
# 이 시간 동안 음성이 없으면 명령이 끝난 것으로 처리합니다.
MICROPHONE_SILENCE_SECONDS=2.0
# 주변 소음이 계속 음성으로 오인되더라도 무한 대기하지 않는 안전 제한입니다.
MICROPHONE_MAX_COMMAND_SECONDS=15.0
# auto 또는 OpenCV 카메라 인덱스
CAMERA_INDEX=auto

# 안전장치 설정 (Harness Engineering)
# 파일 액세스 허용 경로 (쉼표로 구분, 비우면 프로젝트 루트만 허용)
ALLOWED_PATHS=
# 위험한 명령어 블록리스트 (보조)
BLOCKED_COMMANDS=rm,del,format,mkfs,dd,shutdown,restart
# 허용된 명령어 리스트 (allowlist, 기본은 안전한 명령어만)
ALLOWED_COMMANDS=dir,ls,cd,echo,type,cat,pwd,whoami,date,time,ver,python,pip,git,node,npm
# Optional SMTP mail plugin settings (secrets belong in .env only)
MAIL_FROM=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
