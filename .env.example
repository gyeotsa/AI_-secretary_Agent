# LLM 제공자 선택: "anthropic" 또는 "ollama"
LLM_PROVIDER=ollama

# Anthropic API 키 (필요시 사용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434
# 한국어 성능 좋은 모델 추천: llama3:8b, gemma2:9b, ggml-ko-gemma
OLLAMA_MODEL=llama3

# 기본 설정
MODEL_NAME=llama3
MAX_TOKENS=4096
TEMPERATURE=0.7

# 데이터베이스 설정
DB_PATH=data/assistant.db

# 안전장치 설정 (Harness Engineering)
# 파일 액세스 허용 경로 (쉼표로 구분, 비우면 모든 경로 허용)
ALLOWED_PATHS=
# 위험한 명령어 블록리스트
BLOCKED_COMMANDS=rm,del,format,mkfs,dd,shutdown,restart
