# LLM 제공자 선택: "anthropic", "ollama", "hybrid"
LLM_PROVIDER=hybrid

# Anthropic API 키 (필요시 사용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# API에서 사용하는 Claude 고정 모델 ID
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# hybrid 모드에서 Claude를 우선 사용할 역할(기본은 Tool Reasoner만)
HYBRID_CLAUDE_ROLES=reasoning

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434
# 한국어 성능 좋은 모델 추천: llama3:8b, gemma2:9b, ggml-ko-gemma
OLLAMA_MODEL=llama3

# 기본 설정
MODEL_NAME=llama3
MAX_TOKENS=4096
TEMPERATURE=0.7

# 데이터베이스 설정
DB_PATH=data/assistant.db

# RAG 모델은 실행 중 자동 다운로드하지 않고 아래 로컬 경로에서만 불러옵니다.
RAG_EMBEDDING_MODEL_PATH=data/models/bge-m3
# 선택 사항: 로컬 reranker 경로. 비우면 키워드 기반 재정렬을 사용합니다.
RAG_RERANKER_MODEL_PATH=

# 안전장치 설정 (Harness Engineering)
# 파일 액세스 허용 경로 (쉼표로 구분, 비우면 프로젝트 루트만 허용)
ALLOWED_PATHS=
# 위험한 명령어 블록리스트 (보조)
BLOCKED_COMMANDS=rm,del,format,mkfs,dd,shutdown,restart
# 허용된 명령어 리스트 (allowlist, 기본은 안전한 명령어만)
ALLOWED_COMMANDS=dir,ls,cd,echo,type,cat,pwd,whoami,date,time,ver,python,pip,git,node,npm
# Optional SMTP mail plugin settings (secrets belong in .env only)
MAIL_FROM=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
